# ==============================================================================
# Vault Environment Configuration Example
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/vault
# For local native Homebrew Postgres: postgresql://postgres:postgres@localhost:5432/vault
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vault

# Auth & Security
JWT_SECRET=dev-secret-change-in-production-vault-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & OCR Providers (Defaults to mock mode, runs with NO keys required)
VAULT_LLM_PROVIDER=mock
# Optional API keys for real providers:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
